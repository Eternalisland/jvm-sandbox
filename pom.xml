        <!--
            2026-09 third-party security baseline.
            Versions are centralized here so core/debug/mgr modules cannot silently drift back to
            vulnerable legacy releases. Only stable releases are selected; alpha/beta/milestone
            versions reported by versions-maven-plugin are intentionally excluded.
        -->
        <junit.version>6.1.3</junit.version>
        <jakarta.servlet.version>6.1.0</jakarta.servlet.version>
        <jakarta.annotation.version>3.0.0</jakarta.annotation.version>
        <metainf-services.version>1.11</metainf-services.version>
        <slf4j.version>2.0.19</slf4j.version>
        <logback.version>1.6.3</logback.version>
        <commons-lang3.version>3.20.0</commons-lang3.version>
        <commons-collections4.version>4.6.0</commons-collections4.version>
        <commons-io.version>2.22.0</commons-io.version>
        <netty.version>4.2.18.Final</netty.version>
        <asm.version>9.10.1</asm.version>
        <guava.version>33.7.1-jre</guava.version>
        <ognl.version>3.4.12</ognl.version>
    </properties>

    <profiles>

        <!-- 发布到Maven中央仓库才激活：-P sonatype -->
        <profile>
            <id>sonatype</id>
            <build>
                <plugins>
                    <!-- 为了发布到MAVEN中央仓库而用的插件 -->
                    <plugin>
                        <groupId>org.sonatype.plugins</groupId>
                        <artifactId>nexus-staging-maven-plugin</artifactId>
                        <version>1.6.7</version>
                        <extensions>true</extensions>
                        <configuration>
                            <serverId>luanjia-ossrh</serverId>
                            <nexusUrl>https://oss.sonatype.org/</nexusUrl>
                            <autoReleaseAfterClose>true</autoReleaseAfterClose>
                        </configuration>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>1.5</version>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
            <!-- 这里是为了发布到MAVEN中央仓库所做的配置 -->
            <distributionManagement>
                <snapshotRepository>
                    <id>luanjia-ossrh</id>
                    <url>https://oss.sonatype.org/content/repositories/snapshots</url>
                </snapshotRepository>
                <repository>
                    <id>luanjia-ossrh</id>
                    <url>https://oss.sonatype.org/service/local/staging/deploy/maven2/</url>
                </repository>
            </distributionManagement>
        </profile>

    </profiles>

    <reporting>


       <!--
       cobertura-maven-plugin是一个用于代码覆盖率分析的 Maven 插件，它基于 Cobertura 工具。以下是它的主要用途和功能
