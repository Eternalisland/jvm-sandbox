        <pluginManagement>
            <plugins>
                <!-- 1. maven-deploy-plugin (用于部署到远程仓库) -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-deploy-plugin</artifactId>
                    <version>3.1.1</version> <!-- 最新稳定版 -->
                </plugin>

                <!-- 2. maven-assembly-plugin (打包包含依赖的JAR) -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-assembly-plugin</artifactId>
                    <version>3.6.0</version> <!-- 支持JDK 17 -->
                    <configuration>
                        <descriptorRefs>
                            <descriptorRef>jar-with-dependencies</descriptorRef>
                        </descriptorRefs>
                    </configuration>
                </plugin>

                <!-- 3. 替换 cobertura 为 JaCoCo (Cobertura已停止维护) -->
